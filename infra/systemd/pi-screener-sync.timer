[Unit]
Description=Run pi-screener-sync after v1's 16:20 IST screener snapshot on weekdays

[Timer]
# v1 snapshots the screen ~16:20 IST; run after it and again in the evening (idempotent upsert).
OnCalendar=Mon..Fri *-*-* 16:40:00 Asia/Kolkata
OnCalendar=Mon..Fri *-*-* 19:45:00 Asia/Kolkata
Persistent=true
RandomizedDelaySec=120
Unit=pi-screener-sync.service

[Install]
WantedBy=timers.target
