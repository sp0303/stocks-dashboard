[Unit]
Description=Portfolio Intelligence v2 Quote Poller
After=network.target

[Service]
Type=simple
User=opc
WorkingDirectory=/var/www/portfolio-v2/apps/workers
EnvironmentFile=/etc/pi/worker.env
ExecStart=/var/www/portfolio-v2/.venv/bin/python3 pi_workers/quote_poller.py
Restart=always
RestartSec=3
LimitNOFILE=65536
MemoryMax=512M

[Install]
WantedBy=multi-user.target
