[Unit]
Description=Run pi-orb-sync every 5 min 09:00-16:00 IST on weekdays, plus once after the close

[Timer]
OnCalendar=Mon..Fri *-*-* 09..15:00/5:00 Asia/Kolkata
OnCalendar=Mon..Fri *-*-* 16:00:00 Asia/Kolkata
OnCalendar=Mon..Fri *-*-* 16:45:00 Asia/Kolkata
Persistent=true
AccuracySec=30s
Unit=pi-orb-sync.service

[Install]
WantedBy=timers.target
