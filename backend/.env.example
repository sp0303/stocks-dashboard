# ── Backend environment ───────────────────────────────────────────
# Leave MONGODB_URL empty to run with the JSON-file fallback store (no DB needed).
# Paste your Mongo connection string here to switch to MongoDB — no code change.
MONGODB_URL=
MONGODB_DB=stocks

# Market data cache (seconds)
QUOTE_CACHE_TTL_SECONDS=900

# CORS: "*" for local dev, or comma-separated origins (e.g. your GitHub Pages URL)
CORS_ORIGINS=*

# Ollama — local, free narration provider, tried before Cloudflare. Needs
# `ollama serve` running on the same host with OLLAMA_MODEL already pulled.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Cloudflare Workers AI — narration for the holding-summary insight card.
# Leave CF_API_TOKEN empty to disable narration (structured metrics still work).
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Chosen after testing all Workers-AI-Free-plan text-gen models on the actual
# narration task: gemma-4-26b-a4b-it (the original pick) is a reasoning model
# that burns the whole token budget on hidden chain-of-thought and returns
# empty text at low max_tokens — llama-3.3-70b-instruct-fp8-fast was the most
# accurate, complete, and fastest (~1.5s) of the models that returned usable text.
CF_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
